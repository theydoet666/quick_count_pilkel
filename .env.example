# ============================================================
# TEMPLATE KONFIGURASI — Quick Count Pilkel Belega 2026
# ============================================================
# CARA PENGGUNAAN:
#   1. Salin file ini: cp .env.example .env
#   2. Isi nilai-nilai di bawah dengan data project Supabase Anda
#   3. JANGAN PERNAH commit file .env asli ke git
#
# KEAMANAN KRITIS:
#   - File .env SUDAH ada di .gitignore — pastikan tidak pernah di-commit
#   - Jika key pernah ter-commit secara tidak sengaja, SEGERA rotasi key di:
#     Supabase Dashboard > Project Settings > API > Reset keys
#   - Bersihkan riwayat git dengan `git filter-repo` atau BFG Repo-Cleaner
#     lalu force-push, dan minta semua kolaborator re-clone
#   - Anon key BOLEH ada di frontend (desain Supabase), tapi keamanan
#     sesungguhnya bergantung pada RLS yang benar — bukan kerahasiaan anon key
# ============================================================

# URL project Supabase Anda
# Contoh: https://abcdefghijklmn.supabase.co
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# Anon/public key dari Supabase (bukan service_role key!)
# Dapatkan dari: Project Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=your-anon-key-here
