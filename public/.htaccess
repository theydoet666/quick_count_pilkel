# ==============================================================================
# KONFIGURASI APACHE WEB SERVER (.htaccess)
# Domain Produksi: https://pilkel.belega.id/
# Sistem Hitung Cepat (Quick Count) Pilkel Desa Belega 2026
# ==============================================================================

# 1. Nonaktifkan Directory Listing (Mencegah intip isi folder)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 2. Paksa HTTPS & Domain Kanonikal (https://pilkel.belega.id/)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.pilkel\.belega\.id$ [NC]
  RewriteRule ^(.*)$ https://pilkel.belega.id/$1 [L,R=301]

  # 3. Jangan ubah jika file atau folder fisik memang ada di hosting
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. SPA Fallback: Arahkan seluruh rute React (/admin, dll.) ke index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 5. Proteksi File Sensitif & Konfigurasi (.env, .git, .sql, .ts, dll)
# ------------------------------------------------------------------------------
<FilesMatch "(\.(env|git|sql|json|ts|tsx|md|yml|yaml|log|bak|config)|^\.)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 6. Kompresi Gzip / Deflate untuk Akses Super Cepat & Ringan
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
</IfModule>

# ------------------------------------------------------------------------------
# 7. Browser Caching untuk Aset Statis (CSS, JS, Gambar)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # File HTML tidak dicache agar update realtime & versi aplikasi selalu segar
  ExpiresByType text/html "access plus 0 seconds"
  
  # Aset bundle Vite (dengan hash unik) dicache lama untuk efisiensi maksimal
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 8. Header Keamanan Web Tingkat Tinggi (Security Headers & CSP)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Mencegah MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Mencegah website di-iframe oleh domain luar (Anti Clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Referrer Policy yang aman
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS: Paksa browser selalu menggunakan koneksi HTTPS terenkripsi
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Izin perangkat keras (kamera untuk foto C1 Plano, blokir mikrofon & lokasi)
  Header always set Permissions-Policy "camera=*, microphone=(), geolocation=()"

  # Content-Security-Policy (CSP) disesuaikan untuk domain https://pilkel.belega.id/
  Header always set Content-Security-Policy "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob: https: https://*.supabase.co https://images.unsplash.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; frame-ancestors 'self';"
</IfModule>
